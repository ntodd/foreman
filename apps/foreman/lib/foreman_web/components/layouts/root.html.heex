<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="referrer" content="same-origin" />
    <%!-- Classic and synchronous on purpose: it sets data-theme before
         the first paint. --%>
    <script phx-track-static src={~p"/assets/js/theme.js"}>
    </script>
    <.live_title default="Foreman" suffix={assigns[:page_title] && " · Foreman"} phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="icon" type="image/svg+xml" href={~p"/images/mark.svg"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
