
ARG _DEV_CONTAINERS_BASE_IMAGE=scratch
FROM debian:bookworm-slim AS dev_container_auto_added_stage_label
RUN useradd -m -s /bin/bash dev





ARG _DEV_CONTAINERS_BASE_IMAGE=scratch

FROM $_DEV_CONTAINERS_BASE_IMAGE AS dev_containers_feature_content_normalize
USER root
COPY --from=dev_containers_feature_content_source devcontainer-features.builtin.env /tmp/build-features/
RUN chmod -R 0755 /tmp/build-features/

FROM $_DEV_CONTAINERS_BASE_IMAGE AS dev_containers_target_stage

USER root

RUN mkdir -p /tmp/dev-container-features
COPY --from=dev_containers_feature_content_normalize /tmp/build-features/ /tmp/dev-container-features

RUN \
echo "_CONTAINER_USER_HOME=$( (command -v getent >/dev/null 2>&1 && getent passwd 'root' || grep -E '^root|^[^:]*:[^:]*:root:' /etc/passwd || true) | cut -d: -f6)" >> /tmp/dev-container-features/devcontainer-features.builtin.env && \
echo "_REMOTE_USER_HOME=$( (command -v getent >/dev/null 2>&1 && getent passwd 'dev' || grep -E '^dev|^[^:]*:[^:]*:dev:' /etc/passwd || true) | cut -d: -f6)" >> /tmp/dev-container-features/devcontainer-features.builtin.env


RUN --mount=type=bind,from=dev_containers_feature_content_source,source=second_0,target=/tmp/build-features-src/second_0 \
    cp -ar /tmp/build-features-src/second_0 /tmp/dev-container-features \
 && chmod -R 0755 /tmp/dev-container-features/second_0 \
 && cd /tmp/dev-container-features/second_0 \
 && chmod +x ./devcontainer-features-install.sh \
 && ./devcontainer-features-install.sh \
 && rm -rf /tmp/dev-container-features/second_0

ENV ZED_HOME="/opt/zed"
ENV PATH="${ZED_HOME}/bin:${PATH}"
ENV QUOTED="a \"q\" \\ $x"
RUN --mount=type=bind,from=dev_containers_feature_content_source,source=local-feature_1,target=/tmp/build-features-src/local-feature_1 \
    cp -ar /tmp/build-features-src/local-feature_1 /tmp/dev-container-features \
 && chmod -R 0755 /tmp/dev-container-features/local-feature_1 \
 && cd /tmp/dev-container-features/local-feature_1 \
 && chmod +x ./devcontainer-features-install.sh \
 && ./devcontainer-features-install.sh \
 && rm -rf /tmp/dev-container-features/local-feature_1





ARG _DEV_CONTAINERS_IMAGE_USER=root
USER $_DEV_CONTAINERS_IMAGE_USER

LABEL devcontainer.metadata="[ \
{\"id\":\"./second\",\"onCreateCommand\":[\"echo\",\"second-on-create\"]}, \
{\"id\":\"./local-feature\",\"postCreateCommand\":\"echo feature-post-create\",\"init\":true,\"capAdd\":[\"SYS_PTRACE\"],\"securityOpt\":[\"seccomp=unconfined\"],\"entrypoint\":\"/usr/local/share/local-entry.sh\",\"mounts\":[{\"type\":\"volume\",\"source\":\"feature-vol-\${devcontainerId}\",\"target\":\"/feature-vol\"}]}, \
{\"postCreateCommand\":\"echo post-create && id -un && echo \$REMOTE_ONE\",\"postStartCommand\":{\"a\":\"echo start-a\",\"b\":[\"echo\",\"start-b\"]},\"mounts\":[\"type=volume,source=oracle-data,target=/data\"],\"containerEnv\":{\"FROM_CONFIG\":\"a \$b \\\"c\\\"\",\"ID\":\"\${devcontainerId}\"},\"remoteUser\":\"dev\",\"remoteEnv\":{\"REMOTE_ONE\":\"one\",\"WITH_PATH\":\"\${containerEnv:PATH}:/extra\"}} \
]"

ENV FROM_CONFIG="a \$b \"c\""
ENV ID="00p43hv7kvpt6ukvcaq9p4nibjrirlta6qtdfgfqdrjplstb733g"
