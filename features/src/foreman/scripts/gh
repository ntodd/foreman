#!/bin/sh
# Runs the real gh with the environment's current GitHub token. The token
# is refreshed every few hours, so it's read on every call rather than
# exported once into a shell that may outlive it.
self_dir=/usr/local/share/foreman/bin
real=

old_ifs=$IFS
IFS=:
for dir in $PATH; do
  [ "$dir" = "$self_dir" ] && continue
  if [ -x "$dir/gh" ]; then
    real="$dir/gh"
    break
  fi
done
IFS=$old_ifs

if [ -z "$real" ]; then
  echo "gh is not installed in this environment" >&2
  exit 127
fi

# The way out to a login of one's own (gh auth login): FOREMAN_GH_TOKEN=off
# runs gh with nothing of Foreman's. It takes a switch because gh stores
# no login while a token is in its environment, and ranks any token there
# above one it has stored, so leaving the token out is the only way to
# either.
if [ "${FOREMAN_GH_TOKEN:-}" = off ]; then
  exec "$real" "$@"
fi

# gh takes its token from GH_TOKEN, then GITHUB_TOKEN. Foreman's stands in
# when the caller has set neither, so a token given either way is the one
# gh uses, as it would anywhere else. A caller can also hand Foreman's own
# token back, as a script does that reads it with gh auth token: that is
# still Foreman's.
foreman_token=
if [ -s /run/foreman/github-token ]; then
  current=$(cat /run/foreman/github-token)
  if [ -z "${GH_TOKEN:-}" ] && [ -z "${GITHUB_TOKEN:-}" ]; then
    GH_TOKEN=$current
    export GH_TOKEN
    foreman_token=1
  elif [ "${GH_TOKEN:-${GITHUB_TOKEN:-}}" = "$current" ]; then
    foreman_token=1
  fi
fi

# GitHub takes an --attach upload from a personal access token and
# refuses the GitHub App token Foreman delivers (cli/cli#14309). The
# helper runs gh with that one upload sent through Foreman, which holds
# a token GitHub accepts, and with everything else as it is.
#
# Only with Foreman's token, so a gh given a token of someone's own does
# what that token allows. Any argument that reads --attach is enough:
# behind the helper a gh that attaches nothing behaves as it does alone,
# and a gh that attaches something without it fails.
helper=/usr/local/share/foreman/foreman-gh-attach
if [ -n "$foreman_token" ] && [ -x "$helper" ]; then
  for arg in "$@"; do
    case $arg in
      --attach | --attach=*) exec "$helper" "$real" "$@" ;;
    esac
  done
fi

exec "$real" "$@"
