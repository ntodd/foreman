#!/bin/sh
# git credential helper: answers for https://github.com with the token
# Foreman keeps fresh in /run/foreman/github-token. It never stores or
# erases anything.
[ "${1:-}" = "get" ] || exit 0

token_file=/run/foreman/github-token
protocol=
host=
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  case "$key" in
    protocol) protocol=$value ;;
    host) host=$value ;;
  esac
done

[ "$protocol" = "https" ] && [ "$host" = "github.com" ] || exit 0
[ -s "$token_file" ] || exit 0

printf 'username=x-access-token\npassword=%s\n' "$(cat "$token_file")"
