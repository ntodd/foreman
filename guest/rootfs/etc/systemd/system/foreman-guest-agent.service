[Unit]
Description=Foreman guest agent
After=foreman-guest-disks.service docker.service
Requires=foreman-guest-disks.service
Wants=docker.service

[Service]
Environment=FOREMAN_AGENT_MODE=guest
Environment=HOME=/var/lib/foreman-agent
Environment=FOREMAN_AGENT_DATA_DIR=/var/lib/foreman-agent
Environment=RELEASE_TMP=/run/foreman-agent
RuntimeDirectory=foreman-agent
WorkingDirectory=/var/lib/foreman-agent
ExecStart=/opt/foreman-agent/bin/foreman_agent start
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
