[Unit]
Description=Join vsock port 1024 to the Foreman guest agent
After=foreman-guest-agent.service systemd-modules-load.service

[Service]
ExecStart=/usr/bin/socat VSOCK-LISTEN:1024,reuseaddr,fork UNIX-CONNECT:/run/foreman-guest/agent.sock
Restart=always
RestartSec=0.2

[Install]
WantedBy=multi-user.target
