#!/bin/sh
# Mounts the environment's disks. The data disk holds everything the environment keeps: Docker's images,
# containers and volumes, the clone, and the guest agent's state. The
# agent disk is the box's agent release, read-only.
set -eu

disk() { # serial, the device it is when there's no by-id link
  i=0
  while [ $i -lt 100 ]; do
    if [ -e "/dev/disk/by-id/virtio-$1" ]; then
      readlink -f "/dev/disk/by-id/virtio-$1"
      return
    fi
    i=$((i + 1))
    sleep 0.05
  done
  echo "$2"
}

udevadm settle --timeout=10 || true
data=$(disk fm-data /dev/vdb)
agent=$(disk fm-agent /dev/vdc)

# Only the provisioning agent knows a disk is new. A missing filesystem
# signature on a disk attached here can mean recoverable damage.
base=/var/lib/foreman-data
mkdir -p "$base"
if ! mountpoint -q "$base" && ! mount -t ext4 -o noatime "$data" "$base"; then
  echo "foreman-guest: could not mount data disk $data; check the filesystem before retrying" >&2
  exit 1
fi

# The provisioning agent gives each new filesystem its owner before
# publication. Losing that marker on an established disk requires repair.
env_id=$(sed -n 's/.*fm\.env=\([0-9a-f-]*\).*/\1/p' /proc/cmdline)
if [ -z "$env_id" ] || [ -L "$base/.env-id" ] || [ ! -f "$base/.env-id" ] ||
   [ "$(cat "$base/.env-id")" != "$env_id" ]; then
  echo "foreman-guest: data disk ownership does not match this environment; check .env-id before retrying" >&2
  exit 1
fi

# 0.6.0 and 0.6.1 owned the workspace, private agent state and files
# inside devcontainers as 997:993. Keep that identity for those disks.
# This also works with prebuilds, which keep srv but discard agent.
# Select only known IDs and do it before binding the persistent home.
uid=1000 gid=1000
if [ "$(stat -c '%F:%u:%g' "$base/srv" 2>/dev/null || true)" = directory:997:993 ]; then
  uid=997 gid=993
fi
if [ "$(id -g foreman)" != "$gid" ]; then groupmod --gid "$gid" foreman; fi
if [ "$(id -u foreman)" != "$uid" ]; then usermod --uid "$uid" foreman; fi

for dir in docker containerd srv agent; do mkdir -p "$base/$dir"; done

bind() {
  mkdir -p "$2"
  mountpoint -q "$2" || mount --bind "$1" "$2"
}
bind "$base/docker" /var/lib/docker
bind "$base/containerd" /var/lib/containerd
bind "$base/srv" /srv/foreman
bind "$base/agent" /var/lib/foreman-agent
# The guest agent's (it runs as foreman, not root).
chown foreman:foreman /srv/foreman /var/lib/foreman-agent

mkdir -p /opt/foreman-agent
mountpoint -q /opt/foreman-agent || mount -o ro "$agent" /opt/foreman-agent
